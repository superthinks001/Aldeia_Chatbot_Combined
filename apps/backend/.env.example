# ============================================
# ALDEIA BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials!

# === Supabase Configuration ===
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# === GitHub API (Optional) ===
GITHUB_TOKEN=your_github_token_here

# === Server Configuration ===
PORT=3001
NODE_ENV=development

# === Database Configuration - PostgreSQL ===
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# === Authentication (JWT) ===
# Generate using: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_different_from_jwt
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=30d

# === Frontend URLs (for CORS) ===
FRONTEND_CHAT_URL=http://localhost:3002
FRONTEND_REBUILD_URL=http://localhost:3000

# === ChromaDB (Optional - for vector search) ===
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=optional_auth_token

# === Stripe (Optional - for billing) ===
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# === Google Translate (Optional) ===

# === Google Maps API (Optional) ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# === Monitoring (Optional) ===
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=debug

# === Claude API (Optional - enables conversational LLM responses) ===
CLAUDE_API_KEY=optional_api_key_for_claude_authentication
CLAUDE_MODEL=claude-sonnet-4-20250514

# === Push Notifications - VAPID Keys ===
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@aldeia.com
